# ==============================================================================
# AROGYASETU GRID — UNIFIED CRITICAL CARE & HOSPITAL COMMAND NETWORK
# Production Deployment (Vercel + Render) & Local Development Environment Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit .env with actual credentials to version control.
# ==============================================================================

# --- Application Runtime Environment ---
# Values: development | testing | production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# --- Portal Frontend Base URL ---
# In development: points to local Next.js dev server (http://localhost:3000)
# In production on Vercel: set to https://arogyasetu-grid.vercel.app
PORTAL_BASE_URL=http://localhost:3000

# --- Allowed CORS Origins (comma-separated) ---
# In development: http://localhost:3000,http://127.0.0.1:3000,http://localhost:8050
# In production: https://arogyasetu-grid.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8050,https://arogyasetu-grid.vercel.app

# --- Database Configuration (PostgreSQL or SQLite) ---
# For local dev with SQLite (default if empty):
DATABASE_URL=sqlite:///data/hospital_app.db
# For production PostgreSQL (e.g. Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/arogyasetu_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Distributed Cache & Rate Limiting (Redis) ---
# Optional in development (falls back to in-memory rate limiting):
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false

# --- Authentication & JWT Security ---
# In production, minimum 32 random characters required:
JWT_SECRET_KEY=arogyasetu-grid-secure-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APPLICANT_JWT_EXPIRE_MINUTES=1440

# --- Email & SMTP Configuration ---
# Values: simulated | smtp
SIH_EMAIL_BACKEND=simulated
# Values: SIMULATED | CONSOLE | EMAIL
SIH_OTP_PROVIDER=SIMULATED

# For SMTP (e.g. Brevo or Gmail SMTP):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=pawanbussiness108@gmail.com
SMTP_PASSWORD=your_smtp_key_here
SMTP_FROM_EMAIL=pawanbussiness108@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=10

# --- Transactional Outbox Worker ---
OUTBOX_POLL_INTERVAL=5.0
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_TIMEOUT_SECONDS=300
OUTBOX_MAX_RETRIES=5

# --- Document Storage & Security ---
STORAGE_BASE_DIR=/tmp/sih_hospital_documents
MAX_DOCUMENT_SIZE_MB=10
ENABLE_MALWARE_SCAN=true

# --- Frontend (Next.js) Public API URL ---
# In development: http://localhost:8050 or http://localhost:8000
# In production on Vercel: https://arogyasetu-grid-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8050
NEXT_PUBLIC_API_URL=http://localhost:8050
